# Clés API : ce fichier est ignoré par git, ne jamais le committer.
# Clé Agent API H Company (platform.hcompany.ai/settings/api-keys)
HAI_API_KEY=
# Nombre maximal de sessions H lancées ensemble (1 à 10, défaut : 10)
HAI_MAX_PARALLEL=10

# Clé eBay (plus tard)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Jeton Hugging Face (huggingface.co/settings/tokens), pour identifier la photo
HF_TOKEN=
# Modèle vision, optionnel (défaut : google/gemma-4-31B-it)
HF_VISION_MODEL=
# Origines autorisées pour l interface (Vercel), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:3000

# Mode démo : captures des agents, avec ?demo=1 dans l adresse de l interface (pitch et vidéo seulement)
DEMO_SHOTS=
