# Clés API : ce fichier est ignoré par git, ne jamais le committer.
# Clé Agent API H Company (platform.hcompany.ai/settings/api-keys)
HAI_API_KEY=
# Nombre maximal de sessions H lancées ensemble (1 à 10, défaut : 10)
HAI_MAX_PARALLEL=10

# Clé eBay (plus tard)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Jeton Hugging Face (huggingface.co/settings/tokens), pour identifier la photo
HF_TOKEN=
# Modèle vision, optionnel (défaut : google/gemma-4-31B-it)
HF_VISION_MODEL=
# Origines autorisées pour l interface (Vercel), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:3000

# Mode démo : captures des agents, avec ?demo=1 dans l adresse de l interface (pitch et vidéo seulement)
DEMO_SHOTS=

# Garde-fous d'usage une fois en ligne (valeurs par défaut entre parenthèses)
# Recherches par adresse IP et par heure (20), photos studio par IP et par heure (40),
# recherches en cours en même temps (4), photos studio activées (1 = oui)
SEARCH_PER_HOUR=
STUDIO_PER_HOUR=
MAX_SEARCHES=
STUDIO_ENABLED=
# Clé de démo : avec ?cle=<la clé> dans l'adresse de l'interface, la limite par adresse IP ne s'applique pas
DEMO_KEY=
# Nombre de proxys de confiance devant le serveur (1 sur un Space Hugging Face), pour lire la vraie adresse IP
TRUSTED_PROXIES=
